{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2f/design",
  "title": "design.json (MVP-A)",
  "type": "object",
  "required": [
    "schemaVersion",
    "capture",
    "root",
    "assets",
    "report"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "0.1.0-spike"
      ]
    },
    "capture": {
      "type": "object",
      "required": [
        "source",
        "viewport",
        "document",
        "deviceScaleFactor",
        "scroll",
        "scrollMode"
      ],
      "properties": {
        "viewport": {
          "$ref": "#/$defs/size"
        },
        "document": {
          "$ref": "#/$defs/size"
        },
        "deviceScaleFactor": {
          "type": "number",
          "minimum": 1
        },
        "scroll": {
          "type": "object",
          "properties": {
            "x": {
              "const": 0
            },
            "y": {
              "const": 0
            }
          }
        },
        "scrollMode": {
          "enum": [
            "viewport",
            "full-content"
          ]
        },
        "expandSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rasterSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "root": {
      "$ref": "#/$defs/frame"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "mime",
          "pixelWidth",
          "pixelHeight",
          "storage"
        ],
        "properties": {
          "mime": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "pixelWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "pixelHeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "storage": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "inline",
                  "file",
                  "zip"
                ]
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "object"
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "box": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rgba": {
      "type": "object",
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "box",
        "absBox",
        "opacity",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "absBox": {
          "$ref": "#/$defs/box"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/frame"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "properties": {
                "type": {
                  "const": "image"
                },
                "assetId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fit": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "assetId"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "properties": {
                "type": {
                  "const": "raster"
                },
                "assetId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "assetId",
                "reason"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "properties": {
                "type": {
                  "const": "vector"
                },
                "svg": {
                  "type": "string",
                  "pattern": "<svg"
                },
                "fallbackAssetId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type",
                "svg"
              ]
            }
          ]
        }
      ]
    },
    "frame": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "frame"
            },
            "fills": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "solid"
                      },
                      "color": {
                        "$ref": "#/$defs/rgba"
                      }
                    },
                    "required": [
                      "type",
                      "color"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "assetId": {
                        "type": "string"
                      },
                      "scaleMode": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "assetId"
                    ]
                  }
                ]
              }
            },
            "clip": {
              "type": "boolean"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "effects": {
              "type": "array"
            }
          },
          "required": [
            "type",
            "fills",
            "clip",
            "children"
          ]
        }
      ]
    },
    "text": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "text"
            },
            "originalText": {
              "type": "string"
            },
            "visualLines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end",
                  "box"
                ]
              }
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ]
              }
            },
            "style": {
              "type": "object",
              "required": [
                "cssFamilies",
                "weight",
                "size",
                "lineHeight"
              ]
            },
            "role": {
              "enum": [
                "content",
                "input-value",
                "placeholder"
              ]
            },
            "wrap": {
              "enum": [
                "none",
                "figma"
              ]
            }
          },
          "required": [
            "type",
            "originalText",
            "visualLines",
            "runs",
            "style"
          ]
        }
      ]
    }
  }
}